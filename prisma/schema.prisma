
//schema prima

datasource db{

    provider="postgresql"
    url=env("DATABASE_URL")
}

generator client{

provider="prisma-client-js"
}

enum Role{
    admin
    user
}

enum Category {
    femme
    homme
    enfant
}

enum Type {
    ensemble
    body
    soutien_gorge
    pyjama
    corset
    culotte
    robe
    combinaison
    shorty
    boxer
    maillot
    slip
    calecon
    chaussette
    gigoteuse
}

enum Status{
    pending
    paid
    delivered
}
model User{
    id           Int @id @default(autoincrement())
    email        String @unique
    password     String
    firstName    String
    lastName     String
    role         Role    @default(user)
    adresse      String
    phone        Int
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt

    order        Order[]
    refreshtoken RefreshToken[]
    likes        ProductLike[]
}

model Testimonial {
    id         Int      @id @default(autoincrement())
    authorName String
    authorRole String?
    content    String
    rating     Int      @default(5)
    isPublished Boolean @default(false)
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt
}

model RefreshToken{
    id        Int @id @default(autoincrement())
    token     String @unique
    revoke    Boolean
    createdAt DateTime @default(now())
    expireAt  DateTime

    idUser Int

    user User  @relation(fields:[idUser],references:[id], onDelete:Cascade)
}

model Order{
    id            Int @id @default(autoincrement())
    status        Status @default(pending)
    totalPrice    Float 
    dateOrder     DateTime @default(now())
    idUser        Int
    user          User   @relation(fields:[idUser] , references : [id], onDelete:Cascade)
    orderDetails  OrderDetails[]
    
}

model Product{
    id           Int @id @default(autoincrement())
    name         String
    description  String
    price        Float
    image        String
    type         Type
    category     Category
    createdAt    DateTime @default(now())
    variante     Variante[]

    brandId      Int
    brand        Brand  @relation(fields:[brandId], references:[id], onDelete:Cascade)
    likes        ProductLike[]
}

model Brand{
    id          Int @id @default(autoincrement())
    name        String
    description String

    product Product[]
}

model OrderDetails{
    id          Int @id @default(autoincrement())
    quantity    Int 
    price       Float

    orderId      Int
    order        Order   @relation(fields:[orderId],references:[id], onDelete:Cascade)

    varianteId  Int
    variante    Variante   @relation(fields:[varianteId], references:[id], onDelete:Cascade)
}

model Variante{
    id           Int  @id  @default(autoincrement())
    stock        Int
    price        Float
    image        String
    orderDetails  OrderDetails[]
    productId    Int
    product      Product  @relation(fields:[productId], references:[id], onDelete:Cascade)
    sizes        Size[]   @relation("VarianteSizes")
    idColor      Int 
    color        Color  @relation(fields:[idColor],references:[id], onDelete:Cascade)
}

model Color{
    id       Int @id @default(autoincrement())
    code     String
    variante Variante[]
}

model Size{
    id       Int @id @default(autoincrement())
    label    String @unique
    variante Variante[] @relation("VarianteSizes")
}

model ProductLike {
    id        Int      @id @default(autoincrement())
    userId    Int
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    productId Int
    product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
    createdAt DateTime @default(now())

    @@unique([userId, productId])
}