
//schema prima

datasource db{

    provider="postgresql"
    url=env("DATABASE_URL")
}

generator client{

provider="prisma-client-js"
}

enum Role{
    admin
    user
}
enum Type{
    chaussette
    dessous
}

enum Status{
    pending
    paid
    delivered
}
model User{
    id         Int @id @default(autoincrement())
    email      String @unique
    password   String
    firstName  String
    lastName   String
    role       Role    @default(user)
    adresse    String
    phone      String
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt

    order       Order[]
}

model Order{
    id            Int @id @default(autoincrement())
    status        Status @default(pending)
    totalPrice    Float 
    dateOrder     DateTime @default(now())
    idUser        Int
    user          User   @relation(fields:[idUser] , references : [id])
    orderDetails  OrderDetails[]
    
}

model Product{
    id           Int @id @default(autoincrement())
    title        String
    description  String
    price        Float
    image        String
    type         Type

    variante     Variante[]

    brandId      Int
    brand        Brand  @relation(fields:[brandId], references:[id])
}

model Brand{
    id          Int @id @default(autoincrement())
    name        String
    description String

    product Product[]
}

model OrderDetails{
    id          Int @id @default(autoincrement())
    quantity    Int 
    price       Float

    orderId      Int
    order        Order   @relation(fields:[orderId],references:[id])

    varianteId  Int
    variante    Variante   @relation(fields:[varianteId], references:[id])
}

model Variante{
    id           Int  @id  @default(autoincrement())
    stock        Int
    price        Float
    image        String
    orderDetails  OrderDetails[]
    productId    Int
    product      Product  @relation(fields:[productId], references:[id])
    idSize       Int  
    size Size    @relation(fields:[idSize],references:[id])
    idColor      Int 
    color        Color  @relation(fields:[idColor],references:[id])
}

model Color{
    id       Int @id @default(autoincrement())
    code     String
    variante Variante[]
}

model Size{
    id       Int @id @default(autoincrement())
    label    String
    variante Variante[]
}