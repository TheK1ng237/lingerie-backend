{
  "name": "lingerie-backend",
  "version": "1.0.0",
  "engines": {
    "node": ">=22"
  },
  "description": "backen of lingerie app",
  "author": "thek1ng237",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch  src/index.ts",
    "build": "tsc",
    "vercel-build": "prisma migrate deploy && npm run build",
    "render-build": "prisma migrate deploy && npm run build",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:prod": "tsx prisma/seed.prod.ts",
    "db:studio": "prisma studio",
    "db:push": "prisma db push",
    "test": "node --test",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.21.0",
    "@supabase/supabase-js": "^2.116.0",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "nodemon": "^3.1.14",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "rate-limit-redis": "^6.0.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/hpp": "^0.2.7",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "pino-pretty": "^13.1.3",
    "prisma": "^5.21.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
