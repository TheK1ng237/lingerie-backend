DATABASE_URL=postgresql://user:password@localhost:5432/lingerie
JWT_ACCESS_SECRET=replace_with_at_least_32_characters
JWT_REFRESH_SECRET=replace_with_at_least_32_characters
PORT=4000
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# Email transactionnel
RESEND_API_KEY=your_resend_api_key
NEWSLETTER_FROM_EMAIL=onboarding@resend.dev
NEWSLETTER_SITE_URL=http://localhost:3000

# Supabase Storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_server_side_service_role_key
SUPABASE_STORAGE_BUCKET=product-images

# Production Admin Seed
ADMIN_EMAIL=admin@lingerie.com
ADMIN_PASSWORD=YourSecurePassword123!
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=Principal
ADMIN_ADDRESS=Siège Lingerie
ADMIN_PHONE=600000000

# WhatsApp Cloud API (optional)
WHATSAPP_ACCESS_TOKEN=your_meta_access_token
WHATSAPP_PHONE_NUMBER_ID=342452345234523
WHATSAPP_ADMIN_PHONE=237...
WHATSAPP_GRAPH_VERSION=v25.0
WHATSAPP_ORDER_TEMPLATE=hello_world
WHATSAPP_TEMPLATE_LANGUAGE=fr